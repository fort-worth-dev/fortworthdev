---
import ShellLayout from './ShellLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  category?: string;
}

const { title, description, date, category } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<ShellLayout title={`${title} — Fort Worth Dev`} description={description} ogType="article">
  <article>
    <header class="px-4 md:px-6 py-8 md:py-12 border-b border-line-1">
      <a
        href="/blog/"
        class="inline-block text-label text-ink-2 tracking-wide mb-6 transition-colors duration-150 hover:text-ink-0"
      >
        ← ls ../writing
      </a>

      <div class="flex items-baseline gap-3">
        <time datetime={date.toISOString()} class="text-label text-term-amber tracking-[0.15em]">
          {formattedDate}
        </time>
        {category && <span class="text-label text-term-cyan tracking-wide">{category}/</span>}
      </div>
      <h1
        class="text-ink-0 text-3xl md:text-4xl font-extrabold mt-3 mb-4"
        style="letter-spacing: -0.035em;"
      >
        {title}
      </h1>
      <p class="text-lead text-ink-1 measure">{description}</p>
    </header>

    <div class="prose px-4 md:px-6 py-8 md:py-12">
      <slot />
    </div>
  </article>

  <p class="px-4 md:px-6 py-4 border-t border-line-1 text-micro text-ink-3 tracking-widest">
    © {new Date().getFullYear()} fortworthdev.com — Fort Worth, Texas
  </p>
</ShellLayout>

<style>
  /* Long-form body copy is the one place the site drops out of mono — a full
     article in monospace is measurably slower to read. Headings, code, and all
     UI chrome stay mono so the terminal character holds. */
  .prose {
    @apply font-sans text-ink-1;
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 68ch;
  }

  .prose :global(h2) {
    @apply font-mono font-bold text-ink-0 mt-10 mb-4;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    @apply font-mono font-bold text-ink-0 mt-8 mb-3;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .prose :global(p) {
    @apply mb-4;
  }

  .prose :global(a) {
    @apply text-term-cyan underline underline-offset-2 transition-opacity duration-150;
  }
  .prose :global(a:hover) {
    opacity: 0.8;
  }

  .prose :global(ul),
  .prose :global(ol) {
    @apply mb-4 pl-6;
  }
  .prose :global(ul) {
    @apply list-disc;
  }
  .prose :global(ol) {
    @apply list-decimal;
  }
  .prose :global(li) {
    @apply mb-2;
  }

  .prose :global(strong) {
    @apply text-ink-0 font-semibold;
  }

  .prose :global(code) {
    @apply font-mono text-term-green;
    font-size: 0.875em;
  }

  .prose :global(pre) {
    @apply font-mono bg-surface-2 border border-line-1 text-ink-1 p-4 mb-4 overflow-x-auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    @apply text-ink-1;
    font-size: inherit;
  }

  .prose :global(blockquote) {
    @apply mb-4 pl-4 border-l-2 border-line-2 text-ink-2 italic;
  }

  .prose :global(hr) {
    @apply my-8 border-line-1;
  }
</style>
