---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import StatusBar from '@/components/shell/StatusBar.astro';
import StatusLine from '@/components/shell/StatusLine.astro';
import Rail from '@/components/shell/Rail.astro';
import CommandPalette from '@/components/shell/CommandPalette.astro';
import HelpOverlay from '@/components/shell/HelpOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Rail entries. Omit on pages without tiled panes. */
  sections?: { id: string; label: string }[];
}

const { title, description, ogType, sections = [] } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const paletteItems = [
  { href: '/', label: 'home', kind: 'page' },
  { href: '/#about', label: 'about', kind: 'section' },
  { href: '/#engagements', label: 'engagements', kind: 'section' },
  { href: '/#contact', label: 'contact', kind: 'section' },
  { href: '/blog/', label: 'writing', kind: 'page' },
  ...posts.map((p) => ({ href: `/blog/${p.slug}/`, label: p.data.title, kind: 'post' })),
  { href: 'https://x.com/fortworthdev', label: '@fortworthdev on X', kind: 'link', external: true },
  {
    href: 'https://github.com/fortworthdev',
    label: 'github.com/fortworthdev',
    kind: 'link',
    external: true,
  },
  { href: 'mailto:rob@fortworthdev.com', label: 'rob@fortworthdev.com', kind: 'link' },
];
---

<BaseLayout title={title} description={description} ogType={ogType}>
  <a href="#content" class="skip-link">skip to content</a>

  <StatusBar />

  <div class="flex items-start">
    {sections.length > 0 && <Rail sections={sections} />}
    <main id="content" class="flex-1 min-w-0">
      <slot />
    </main>
  </div>

  <StatusLine />
  <CommandPalette items={paletteItems} />
  <HelpOverlay />
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const behavior = () => (reduce.matches ? 'auto' : 'smooth');

  const panes = Array.from(document.querySelectorAll<HTMLElement>('[data-pane]'));
  const palette = document.getElementById('palette') as HTMLDialogElement | null;
  const help = document.getElementById('help') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const list = document.getElementById('palette-list');
  const empty = document.getElementById('palette-empty');

  const railLinks = new Map<string, Element>();
  document
    .querySelectorAll<HTMLElement>('[data-rail]')
    .forEach((a) => railLinks.set(a.dataset.rail!, a));

  let current = 0;
  // A smooth scroll emits events the whole way down, which would drag the
  // active marker backwards through every pane it passes. Hold it briefly
  // after an explicit jump, then resync.
  let lockUntil = 0;

  function setActive(i: number) {
    current = i;
    railLinks.forEach((a) => a.classList.remove('is-active'));
    railLinks.get(panes[i]?.id)?.classList.add('is-active');
  }

  // The active pane is the first pane of the lowest row that has scrolled under
  // the status bar. Tiled panes in the same row share a `top`, so picking the
  // *last* qualifying pane would skip every left-hand pane in the layout.
  function updateActive() {
    if (!panes.length || Date.now() < lockUntil) return;
    let idx = 0;
    let deepest = -Infinity;
    for (let i = 0; i < panes.length; i++) {
      const top = panes[i].getBoundingClientRect().top;
      if (top <= 80 && top > deepest + 4) {
        deepest = top;
        idx = i;
      }
    }
    setActive(idx);
  }

  function scrollToPane(i: number) {
    if (!panes.length) return;
    const next = Math.max(0, Math.min(i, panes.length - 1));
    lockUntil = Date.now() + 700;
    setActive(next);
    panes[next].scrollIntoView({ behavior: behavior(), block: 'start' });
    panes[next].focus({ preventScroll: true });
    setTimeout(updateActive, 750);
  }

  if (panes.length) {
    // Leading-edge throttle with a trailing call, so the marker lands correctly
    // on the last frame of a scroll without running the arithmetic every event.
    let lastRun = 0;
    let trailing: ReturnType<typeof setTimeout>;
    const onScroll = () => {
      const now = Date.now();
      clearTimeout(trailing);
      if (now - lastRun >= 100) {
        lastRun = now;
        updateActive();
      } else {
        trailing = setTimeout(() => {
          lastRun = Date.now();
          updateActive();
        }, 100);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateActive();
  }

  function paletteItems() {
    if (!list) return [] as HTMLElement[];
    return Array.from(list.querySelectorAll<HTMLElement>('[data-item]')).filter(
      (a) => !(a.parentElement as HTMLElement).hidden
    );
  }

  let activeItem = 0;

  function setActiveItem(i: number) {
    const items = paletteItems();
    if (!items.length) return;
    activeItem = (i + items.length) % items.length;
    items.forEach((a, n) => a.classList.toggle('is-active', n === activeItem));
    items[activeItem].scrollIntoView({ block: 'nearest' });
  }

  function filterPalette() {
    if (!list || !input) return;
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    list.querySelectorAll<HTMLElement>('[data-item]').forEach((a) => {
      const hit = !q || (a.dataset.search || '').includes(q);
      (a.parentElement as HTMLElement).hidden = !hit;
      if (hit) shown++;
    });
    if (empty) empty.hidden = shown > 0;
    setActiveItem(0);
  }

  function closeOverlays() {
    [palette, help].forEach((d) => d?.open && d.close());
  }

  function open(d: HTMLDialogElement | null) {
    if (!d || d.open) return;
    closeOverlays();
    d.showModal();
  }

  input?.addEventListener('input', filterPalette);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || (e.ctrlKey && e.key === 'n')) {
      e.preventDefault();
      setActiveItem(activeItem + 1);
    } else if (e.key === 'ArrowUp' || (e.ctrlKey && e.key === 'p')) {
      e.preventDefault();
      setActiveItem(activeItem - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      paletteItems()[activeItem]?.click();
    }
  });
  palette?.addEventListener('close', () => {
    if (input) input.value = '';
    filterPalette();
  });

  let pending = '';
  let pendingTimer: ReturnType<typeof setTimeout>;

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeOverlays();
      return;
    }

    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (palette?.open || help?.open) return;

    if (pending === 'g') {
      clearTimeout(pendingTimer);
      pending = '';
      if (e.key === 'h') {
        e.preventDefault();
        location.href = '/';
      } else if (e.key === 'b') {
        e.preventDefault();
        location.href = '/blog/';
      } else if (e.key === 'g') {
        e.preventDefault();
        current = 0;
        window.scrollTo({ top: 0, behavior: behavior() });
      }
      return;
    }

    switch (e.key) {
      case 'j':
        e.preventDefault();
        scrollToPane(current + 1);
        break;
      case 'k':
        e.preventDefault();
        scrollToPane(current - 1);
        break;
      case 'G':
        e.preventDefault();
        window.scrollTo({ top: document.body.scrollHeight, behavior: behavior() });
        break;
      case 'g':
        pending = 'g';
        pendingTimer = setTimeout(() => (pending = ''), 700);
        break;
      case '/':
        e.preventDefault();
        open(palette);
        input?.focus();
        break;
      case '?':
        e.preventDefault();
        open(help);
        break;
    }
  });

  const clockEl = document.querySelector('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZoneName: 'short',
  });
  function tick() {
    if (clockEl) clockEl.textContent = fmt.format(new Date());
  }
  tick();
  setInterval(tick, 30_000);
</script>
