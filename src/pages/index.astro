---
import { getCollection } from 'astro:content';
import ShellLayout from '@/layouts/ShellLayout.astro';
import Pane from '@/components/shell/Pane.astro';
import Hero from '@/components/Hero.astro';
import StatsBar from '@/components/StatsBar.astro';
import About from '@/components/About.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Contact from '@/components/Contact.astro';
import PostList from '@/components/PostList.astro';
import { resourceTypes, countOf } from '@/data/resources';

// Order matters and must match the DOM order below — the rail numbers the
// panes as it lists them. What a visitor can *use* (writing, resources) sits
// directly under the hero; the biographical panes follow.
const sections = [
  { id: 'whoami', label: 'whoami' },
  { id: 'writing', label: 'writing' },
  { id: 'resources', label: 'resources' },
  { id: 'about', label: 'about' },
  { id: 'skills', label: 'specializations' },
  { id: 'projects', label: 'projects' },
  { id: 'contact', label: 'contact' },
];

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<ShellLayout sections={sections}>
  <!-- Panes tile on a 5-column grid so widths vary deliberately: full-bleed
       hero, then 3/2 splits that give each pane a different rhythm. -->
  <div class="grid grid-cols-1 lg:grid-cols-5">
    <Pane
      id="whoami"
      cmd="whoami"
      label="whoami"
      heading={false}
      class="lg:col-span-5 border-b border-line-1"
    >
      <Hero />
    </Pane>

    <div class="lg:col-span-5 border-b border-line-1">
      <StatsBar />
    </div>

    <Pane
      id="writing"
      cmd="ls -la ./writing"
      label="writing"
      class="lg:col-span-3 border-b border-line-1 lg:border-r"
      flush
    >
      <PostList posts={posts} />
    </Pane>

    <Pane
      id="resources"
      cmd="ls ./resources"
      label="resources"
      class="lg:col-span-2 border-b border-line-1"
      flush
    >
      <ul class="list-none">
        {resourceTypes.map(({ type, dir, blurb }) => (
          <li class="row border-b border-line-1 last:border-b-0 transition-colors duration-150">
            <a href={`/resources/${dir}/`} class="block px-4 md:px-6 py-3.5 no-underline">
              <div class="flex items-baseline gap-3 min-w-0">
                <span class="text-meta text-term-amber shrink-0 tabular-nums">
                  {String(countOf(type)).padStart(2, '0')}
                </span>
                <span class="text-body text-term-cyan truncate row-title transition-colors duration-150">
                  {dir}/
                </span>
              </div>
              <p class="text-meta text-ink-2 mt-1">{blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </Pane>

    <Pane
      id="about"
      cmd="cat about.md"
      label="about"
      class="lg:col-span-3 border-b border-line-1 lg:border-r"
    >
      <About />
    </Pane>

    <Pane
      id="skills"
      cmd="./skills.sh"
      label="specializations"
      class="lg:col-span-2 border-b border-line-1"
    >
      <Skills />
    </Pane>

    <Pane
      id="projects"
      cmd="ls ./projects"
      label="projects"
      class="lg:col-span-3 border-b border-line-1 lg:border-r"
      flush
    >
      <Projects />
    </Pane>

    <Pane
      id="contact"
      cmd="cat contact.json"
      label="contact"
      class="lg:col-span-2 border-b border-line-1"
    >
      <Contact />
    </Pane>
  </div>

  <p class="px-4 md:px-6 py-4 text-micro text-ink-3 tracking-widest">
    © {new Date().getFullYear()} fortworthdev.com — Fort Worth, Texas
  </p>
</ShellLayout>
