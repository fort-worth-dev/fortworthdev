---
import { getCollection } from 'astro:content';
import ShellLayout from '@/layouts/ShellLayout.astro';
import Pane from '@/components/shell/Pane.astro';
import Hero from '@/components/Hero.astro';
import NowBuilding from '@/components/NowBuilding.astro';
import PostList from '@/components/PostList.astro';
import Principles from '@/components/Principles.astro';
import ResourceIndex from '@/components/ResourceIndex.astro';
import Contact from '@/components/Contact.astro';

// Order matters and must match the DOM order below — the rail numbers the
// panes as it lists them.
const sections = [
  { id: 'whoami', label: 'whoami' },
  { id: 'building', label: 'now building' },
  { id: 'notes', label: 'field notes' },
  { id: 'principles', label: 'principles' },
  { id: 'resources', label: 'resources' },
  { id: 'contact', label: 'contact' },
];

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<ShellLayout sections={sections}>
  <!-- Panes tile on a 5-column grid so widths carry hierarchy: a full-bleed
       hero, then 3/2 splits that give each row a different rhythm. -->
  <div class="grid grid-cols-1 lg:grid-cols-5">
    <Pane
      id="whoami"
      cmd="whoami"
      label="whoami"
      heading={false}
      flush
      class="lg:col-span-5 border-b border-line-1"
    >
      <Hero posts={posts} />
    </Pane>

    <Pane
      id="building"
      cmd="./workflow --status"
      label="now building"
      class="lg:col-span-3 border-b border-line-1 lg:border-r"
      flush
    >
      <div class="reveal"><NowBuilding /></div>
    </Pane>

    <Pane
      id="notes"
      cmd="ls -t notes/"
      label="field notes"
      class="lg:col-span-2 border-b border-line-1"
      flush
    >
      <div class="reveal">
        <PostList posts={posts.slice(0, 4)} showDescription />
        {posts.length > 0 && (
          <a
            href="/blog/"
            class="block px-4 md:px-6 py-3.5 text-label text-ink-2 tracking-wide border-t border-line-1 no-underline transition-colors duration-150 hover:text-ink-0"
          >
            <span class="text-term-green" aria-hidden="true">$</span> cd notes/ — all
            {posts.length} {posts.length === 1 ? 'entry' : 'entries'}
          </a>
        )}
      </div>
    </Pane>

    <Pane
      id="principles"
      cmd="git diff -- principles.md"
      label="principles"
      class="lg:col-span-3 border-b border-line-1 lg:border-r"
      flush
    >
      <div class="reveal"><Principles /></div>
    </Pane>

    <Pane
      id="resources"
      cmd="tree resources/"
      label="resources"
      class="lg:col-span-2 border-b border-line-1"
      flush
    >
      <div class="reveal"><ResourceIndex /></div>
    </Pane>

    <Pane
      id="contact"
      cmd="cat contact.json"
      label="contact"
      class="lg:col-span-5 border-b border-line-1"
    >
      <div class="reveal"><Contact /></div>
    </Pane>
  </div>

  <p class="px-4 md:px-6 py-4 text-micro text-ink-3 tracking-widest">
    © {new Date().getFullYear()} fortworthdev.com — Fort Worth, Texas
  </p>
</ShellLayout>
