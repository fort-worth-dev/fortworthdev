---
import ShellLayout from '@/layouts/ShellLayout.astro';
import Pane from '@/components/shell/Pane.astro';
---

<ShellLayout title="404 — Fort Worth Dev" description="Page not found.">
  <Pane id="notfound" cmd="cat $REQUEST_URI" label="404" class="border-b border-line-1">
    <p class="text-body text-term-red mb-4">
      cat: no such file or directory
    </p>
    <p class="text-body text-ink-1 measure mb-8">
      That route doesn't exist. Maybe it was moved, or the URL is wrong.
    </p>

    <div class="flex gap-4 flex-wrap">
      <a href="/" class="btn-solid">← home</a>
      <a href="/blog/" class="btn-ghost">read the blog</a>
    </div>
  </Pane>

  <p class="px-4 md:px-6 py-4 text-micro text-ink-3 tracking-widest">
    © {new Date().getFullYear()} fortworthdev.com — Fort Worth, Texas
  </p>
</ShellLayout>
