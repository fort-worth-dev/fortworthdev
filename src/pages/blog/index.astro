---
import { getCollection } from 'astro:content';
import ShellLayout from '@/layouts/ShellLayout.astro';
import Pane from '@/components/shell/Pane.astro';
import PostList from '@/components/PostList.astro';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<ShellLayout
  title="Writing — Fort Worth Dev"
  description="Notes on AI-augmented .NET development — case studies, tooling, and workflows."
>
  <Pane id="writing" cmd="ls -la ./writing" label="writing" class="border-b border-line-1">
    <p class="text-body text-ink-1 measure">
      Notes on AI-augmented .NET development — tooling, architecture, and workflows that ship.
    </p>
    <p class="text-meta text-ink-3 mt-2 tabular-nums">total {posts.length}</p>
  </Pane>

  <div class="border-b border-line-1">
    <PostList posts={posts} showDescription />
  </div>

  <p class="px-4 md:px-6 py-4 text-micro text-ink-3 tracking-widest">
    © {new Date().getFullYear()} fortworthdev.com — Fort Worth, Texas
  </p>
</ShellLayout>
