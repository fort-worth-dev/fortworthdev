---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '#contact', label: 'Contact' },
];
---

<nav
  class="page-x flex flex-wrap justify-between items-center gap-x-4 gap-y-3 py-4 md:py-5 sticky top-0 z-50"
  style="border-bottom: 1px solid var(--border-green); background: rgba(10,12,14,0.92); backdrop-filter: blur(8px);"
>
  <a href="/" class="font-mono text-[13px] text-green-DEFAULT tracking-wide shrink-0">
    <span class="text-muted">~/</span>fortworthdev<span class="text-muted">.com</span>
  </a>

  <ul class="flex gap-4 sm:gap-8 list-none">
    {navLinks.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class="text-[12px] text-ink-2 uppercase tracking-widest transition-colors duration-150 hover:text-green-DEFAULT"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
