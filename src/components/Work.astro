---
// Rendered as directory listing rows rather than cards — the pane header is
// `ls ./engagements`, so the body should look like what ls prints.
const engagements = [
  {
    name: 'ai-tooling-adoption',
    text: 'Team workshops and playbooks for Cursor, Copilot, Claude Code, and custom agent setups — from first install to daily workflow.',
    tools: ['Cursor', 'Copilot', 'Claude Code'],
  },
  {
    name: 'architecture-review',
    text: 'Honest assessments of .NET codebases, LLM integration points, and agentic design — with actionable recommendations, not slide decks.',
    tools: ['.NET'],
  },
  {
    name: 'agentic-pipeline-design',
    text: 'End-to-end workflows that connect coding assistants, MCP servers, CI/CD, and production systems so agents actually ship code.',
    tools: ['MCP'],
  },
  {
    name: 'dev-workflow-consulting',
    text: 'Retainer-style advisory for engineering leaders modernizing how their teams build — AI-augmented without losing rigor.',
    tools: [],
  },
];

// Split a string on the tool names so each can be wrapped in its own span.
function tokenize(text: string, tools: string[]) {
  if (tools.length === 0) return [{ text, isTool: false }];
  const pattern = new RegExp(
    `(${tools.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
    'g'
  );
  return text
    .split(pattern)
    .filter(Boolean)
    .map((part) => ({ text: part, isTool: tools.includes(part) }));
}
---

<ul class="list-none">
  {engagements.map(({ name, text, tools }) => (
    <li class="row px-4 md:px-6 py-4 border-b border-line-1 last:border-b-0 transition-colors duration-150">
      <div class="flex items-baseline gap-3 mb-1.5 min-w-0">
        <span class="text-micro text-ink-3 shrink-0 hidden sm:inline tabular-nums" aria-hidden="true">
          drwxr-xr-x
        </span>
        <span class="text-body text-term-cyan truncate">{name}/</span>
      </div>
      <p class="text-body text-ink-1 sm:pl-[7.5rem]">
        {tokenize(text, tools).map(({ text: part, isTool }) =>
          isTool ? <span class="text-term-violet">{part}</span> : part
        )}
      </p>
    </li>
  ))}
</ul>
