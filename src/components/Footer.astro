---
const year = new Date().getFullYear();
---

<footer
  class="page-x py-6 md:py-7 flex flex-col items-start sm:flex-row sm:justify-between sm:items-center gap-3"
  style="border-top: 1px solid var(--border-green);"
>
  <span class="text-label text-muted tracking-widest">
    © {year} fortworthdev.com — Fort Worth, Texas
  </span>
  <span
    class="text-label text-green-DEFAULT tracking-widest px-2.5 py-1"
    style="border: 1px solid var(--border-green-2);"
  >
    open to consulting
  </span>
</footer>
