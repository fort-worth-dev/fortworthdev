---
// `tone` is the syntax role for the highlighted phrase: violet for types and
// product names, ink-0 where the emphasis is rhetorical rather than semantic.
const cards = [
  {
    label: 'background',
    text: 'Deep-rooted in .NET development since the early 2000s — from Web Forms to Blazor, from SOAP to gRPC. I\'ve seen the stack evolve and I evolve with it.',
    highlight: '.NET development',
    tone: 'text-term-violet',
  },
  {
    label: 'current focus',
    text: 'Agentic & workflow development — connecting AI coding assistants, MCP servers, and CI/CD into pipelines that ship real software. Practicing daily: side projects, courses, and production work.',
    highlight: 'AI coding assistants',
    tone: 'text-term-violet',
  },
  {
    label: 'this site',
    text: 'A public working log. What I build and learn — side projects, agentic experiments, day-job lessons — gets written up here so other developers can move faster.',
    highlight: 'public working log',
    tone: 'text-ink-0',
  },
  {
    label: 'point of view',
    text: 'Speed without verification is just faster failure. The durable skills are context engineering, human-in-the-loop review, and knowing when not to trust the model.',
    highlight: 'faster failure',
    tone: 'text-ink-0',
  },
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
  {cards.map(({ label, text, highlight, tone }) => {
    const parts = text.split(highlight);
    return (
      <div class="card bg-surface-2 border border-line-1 p-5 relative overflow-hidden">
        <div class="text-label text-ink-2 tracking-widest uppercase mb-2.5">{label}</div>
        <p class="text-body text-ink-1">
          {parts.map((part, i) => (
            <>
              {part}
              {i < parts.length - 1 && <strong class={`${tone} font-normal`}>{highlight}</strong>}
            </>
          ))}
        </p>
      </div>
    );
  })}
</div>
