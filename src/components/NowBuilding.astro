---
// What is on the bench right now, rendered as `./workflow --status` output:
// the loop graph first, then one row per project with the stage it is in.
import { projects } from '@/data/projects';
import Pipeline from './Pipeline.astro';

function tokenize(text: string, tools: string[]) {
  if (tools.length === 0) return [{ text, isTool: false }];
  const pattern = new RegExp(
    `(${tools.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
    'g'
  );
  return text
    .split(pattern)
    .filter(Boolean)
    .map((part) => ({ text: part, isTool: tools.includes(part) }));
}
---

<div class="px-4 md:px-6 pt-6 pb-4 border-b border-line-1">
  <Pipeline />
</div>

<ul class="list-none">
  {projects.map(({ name, description, stage, tools, href }, i) => (
    <li class="row px-4 md:px-6 py-4 border-b border-line-1 last:border-b-0 transition-colors duration-150">
      <div class="flex items-baseline gap-3 mb-1.5 min-w-0">
        <span class="text-micro text-ink-3 shrink-0 tabular-nums" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        {href ? (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-body text-term-cyan truncate underline underline-offset-2 decoration-line-2 transition-colors duration-150 hover:decoration-current"
          >
            {name}/
          </a>
        ) : (
          <span class="text-body text-term-cyan truncate">{name}/</span>
        )}
        <span class="text-micro text-ink-3 shrink-0">stage:</span>
        <span class="text-micro text-term-green shrink-0">{stage}</span>
      </div>
      <p class="text-body text-ink-1 pl-[2.5ch]">
        {tokenize(description, tools).map(({ text: part, isTool }) =>
          isTool ? <span class="text-term-violet">{part}</span> : part
        )}
      </p>
    </li>
  ))}
</ul>
