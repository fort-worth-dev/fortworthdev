---
const stats = [
  { num: '25+', label: 'Years .NET' },
  { num: 'AI-first', label: 'Development approach' },
  { num: 'FTW', label: 'Fort Worth, TX' },
  { num: '@fortworthdev', label: 'on X / Twitter' },
];
---

<div
  class="page-x py-5 grid grid-cols-2 sm:grid-cols-4 gap-6 md:gap-12"
  style="border-top: 1px solid var(--border-green); border-bottom: 1px solid var(--border-green);"
>
  {stats.map(({ num, label }) => (
    <div class="flex flex-col gap-0.5">
      <span class="font-display font-extrabold text-green-DEFAULT"
            style="font-size: 26px; letter-spacing: -0.02em;">
        {num}
      </span>
      <span class="text-[11px] text-muted uppercase tracking-widest">{label}</span>
    </div>
  ))}
</div>
