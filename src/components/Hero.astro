---
// The hero is a two-part statement: a plain headline on the left, and on the
// right a terminal session that says the same thing the way the site says
// everything — as commands and their output. The session is real data where
// it can be (the latest notes come from the collection), and the entrance
// is one orchestrated CSS sequence. No JS is needed for it to play, and
// `prefers-reduced-motion` collapses it to a static transcript.
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const PROMPT = 'rob@fortworthdev';

// Schedule: each command types for `dur` then its output prints. Times are
// seconds from load. Kept short — the whole session lands in under 5s.
type Line =
  | { kind: 'cmd'; text: string; at: number; dur: number }
  | { kind: 'out'; html: string; at: number; dim?: boolean };

const latest = posts.slice(0, 2);
const notesOut =
  latest.length > 0
    ? latest.map(
        (p) =>
          `<span class="text-term-amber">${p.data.date.toISOString().slice(0, 10)}</span>  <span class="text-term-cyan">${p.data.category}/</span>${escape(p.slug)}.mdx`
      )
    : ['<span class="text-ink-3">total 0 — first note in progress</span>'];

function escape(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
}

const lines: Line[] = [
  { kind: 'cmd', text: 'whoami', at: 0.4, dur: 0.45 },
  {
    kind: 'out',
    at: 1.0,
    html: 'rob — senior <span class="text-term-violet">.NET</span> engineer, <span class="text-term-amber">25</span> years shipping. Fort Worth, TX.',
  },
  { kind: 'cmd', text: 'cat focus.md', at: 1.4, dur: 0.6 },
  {
    kind: 'out',
    at: 2.15,
    html: 'AI-assisted development, agentic workflows, developer tooling.<br>Field notes written while the work is being done — not after.',
  },
  { kind: 'cmd', text: 'ls -t notes/ | head -2', at: 2.7, dur: 0.9 },
  ...notesOut.map((html, i) => ({ kind: 'out' as const, at: 3.75 + i * 0.12, html })),
  { kind: 'cmd', text: 'git status', at: 4.2, dur: 0.5 },
  {
    kind: 'out',
    at: 4.85,
    html: 'On branch <span class="text-term-cyan">main</span>. Working tree: <span class="text-term-green">building in public</span>.',
  },
];
const promptAt = 5.2;

const prompt = `<span class="text-term-green">${PROMPT}</span><span class="text-ink-3">:~$</span> `;
const transcript =
  lines
    .map((l) =>
      l.kind === 'cmd'
        ? `<div class="t-line" style="--d:${l.at}s">${prompt}<span class="t-cmd text-ink-0" style="--d:${l.at}s;--dur:${l.dur}s;--n:${l.text.length}">${escape(l.text)}</span></div>`
        : `<div class="t-line text-ink-1" style="--d:${l.at}s">${l.html}</div>`
    )
    .join('') +
  `<div class="t-line mt-1" style="--d:${promptAt}s">${prompt}<span class="cursor-block t-cursor" style="--d:${promptAt}s"></span></div>`;
---

<div class="relative overflow-hidden">
  <div class="hero-wash absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="hero-field absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div
    class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 px-4 md:px-10 pt-14 pb-14 md:pt-24 md:pb-24"
  >
    <!-- Statement -->
    <div class="lg:col-span-6 flex flex-col justify-center">
      <p class="text-label text-ink-2 tracking-wide mb-6">
        <span class="text-term-green" aria-hidden="true">$</span> a working log of practical AI-assisted software development
      </p>

      <h1 class="text-display-lg text-ink-0 mb-6">
        25 years of .NET.<br />Now shipping<br />with agents.
      </h1>

      <p class="text-lead text-ink-1 measure mb-10">
        Field notes on AI coding assistants, agentic workflows, and the tooling around them —
        from a senior engineer who is still on the hook for what ships.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="#notes" class="btn-solid">read the field notes</a>
        <a href="/resources/" class="btn-ghost">browse resources</a>
        <a
          href="https://github.com/fort-worth-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          github
        </a>
      </div>
    </div>

    <!-- Session -->
    <div class="lg:col-span-6 flex items-center">
      <div class="term w-full text-meta leading-relaxed" role="img" aria-label="Terminal session: whoami — Rob, senior .NET engineer with 25 years of experience in Fort Worth, Texas. Current focus: AI-assisted development, agentic workflows, developer tooling. Latest notes listed. Git status: building in public.">
        <div class="term-bar" aria-hidden="true">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="ml-2 text-micro text-ink-3 tracking-wide truncate">rob@fortworthdev — ~ — zsh</span>
          <span class="ml-auto text-micro text-ink-3 tabular-nums hidden sm:inline">80×24</span>
        </div>

        <pre
          class="px-4 md:px-5 py-4 overflow-x-auto font-mono whitespace-pre-wrap break-words"
          aria-hidden="true"
          set:html={transcript}
        />
      </div>
    </div>
  </div>
</div>
